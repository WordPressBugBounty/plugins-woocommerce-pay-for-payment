#. Plugin Name of the plugin
#: woocommerce-payforpayment.php
msgid "Pay for Payment for WooCommerce – Payment Gateway Fees & Discounts"
msgstr ""
"Pay for Payment for WooCommerce – Gebühren und Rabatte je Zahlungsmethode"

#. Plugin URI of the plugin
#: woocommerce-payforpayment.php
msgid "https://payforpayment.com/"
msgstr "https://payforpayment.com/"

#. Description of the plugin
#: woocommerce-payforpayment.php
msgid ""
"Charge a fee or give a discount on any WooCommerce payment method. Fixed or "
"percentage, tax aware, with min and max caps."
msgstr ""
"Berechne eine Gebühr oder gewähre einen Rabatt bei jeder WooCommerce-"
"Zahlungsmethode. Fest oder prozentual, steuerbewusst, mit Mindest- und "
"Höchstbetrag."

#. Author of the plugin
#: woocommerce-payforpayment.php
msgid "Karolína Vyskočilová"
msgstr "Karolína Vyskočilová"

#. Author URI of the plugin
#: woocommerce-payforpayment.php
msgid "https://kybernaut.cz"
msgstr "https://kybernaut.cz"

