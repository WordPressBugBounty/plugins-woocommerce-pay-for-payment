#. Plugin Name of the plugin
#: woocommerce-payforpayment.php
msgid "Pay for Payment for WooCommerce – Payment Gateway Fees & Discounts"
msgstr ""
"Pay for Payment for WooCommerce – tariffe e sconti per metodo di pagamento"

#. Plugin URI of the plugin
#: woocommerce-payforpayment.php
msgid "https://payforpayment.com/"
msgstr "https://payforpayment.com/"

#. Description of the plugin
#: woocommerce-payforpayment.php
msgid ""
"Charge a fee or give a discount on any WooCommerce payment method. Fixed or "
"percentage, tax aware, with min and max caps."
msgstr ""
"Applica una tariffa o uno sconto su qualsiasi metodo di pagamento "
"WooCommerce. Fissa o percentuale, con gestione delle tasse e limiti minimo e "
"massimo."

#. Author of the plugin
#: woocommerce-payforpayment.php
msgid "Karolína Vyskočilová"
msgstr "Karolína Vyskočilová"

#. Author URI of the plugin
#: woocommerce-payforpayment.php
msgid "https://kybernaut.cz"
msgstr "https://kybernaut.cz"

#. translators: %s: plugin name.
#: src/Admin.php:305
#, php-format
msgid "Thank you for using %s!"
msgstr "Grazie per aver scelto %s!"

#. translators: 1: plugin name, 2: five-star rating link.
#: src/Admin.php:312
#, php-format
msgid ""
"If you like %1$s please leave us a %2$s rating. A huge thanks in advance!"
msgstr ""
"Se ti piace %1$s, lasciaci una valutazione di %2$s. Grazie mille in anticipo!"

