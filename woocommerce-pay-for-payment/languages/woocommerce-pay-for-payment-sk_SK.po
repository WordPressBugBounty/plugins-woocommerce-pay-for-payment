#, php-format
msgid "Thank you for using %s!"
msgstr "Ďakujeme, že používate %s!"

#. translators: 1: plugin name, 2: five-star rating link.
#: src/Admin.php:312
#, php-format
msgid ""
"If you like %1$s please leave us a %2$s rating. A huge thanks in advance!"
msgstr ""
"Ak sa vám %1$s páči, ohodnoťte nás prosím %2$s. Vopred veľmi pekne ďakujeme!"

